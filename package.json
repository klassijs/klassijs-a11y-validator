{
  "name": "klassijs-a11y-validator",
  "version": "1.0.0",
  "description": "This accessibility verification function serves as an automated accessibility testing tool that helps identify and document accessibility issues based on WCAG standards.",
  "creator": {
    "name": "Larry Goddard",
    "email": "larryg@klassitech.co.uk",
    "linkedin": "https://linkedin.com/in/larryg",
    "youtube": "https://youtube.com/@LarryG_01"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "axe-core",
    "axe",
    "accessibility testing",
    "accessibility verification"
  ],
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "a11y:crawl": "node src/run-a11y-test.js",
    "a11y:crawl-only": "node src/run-a11y-test.js --crawl-only",
    "a11y:pages": "node src/run-a11y-test.js --pages",
    "a11y:pages-file": "node src/run-a11y-test.js --pages-file",
    "a11y:base-pages": "node src/run-a11y-test.js --base-url"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/klassijs/klassijs-a11y-validator.git"
  },
  "dependencies": {
    "axe-core": "^4.11.1",
    "dotenv": "^16.6.1",
    "klassijs-astellen": "^1.0.1",
    "webdriverio": "^9.23.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
